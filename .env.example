# Variables de entorno para propiedades_app

# Base de datos principal (para la web de propiedades)
DATABASE_URL=postgresql://usuario:password@host:5432/base_datos

# Clave secreta de Flask
SECRET_KEY=tu_clave_secreta_aqui_cambiala_en_produccion

# ==================== VARIABLES DEL BOT ====================

# Base de datos para el bot (puede ser la misma o diferente)
BOT_DATABASE_URL=postgresql://usuario:password@host:5432/base_datos_bot

# Telegram para alertas
TELEGRAM_BOT_TOKEN=tu_token_de_bot_telegram
TELEGRAM_CHAT_ID=tu_chat_id_telegram

# Tu número de teléfono para los comentarios
MY_PHONE_NUMBER=0987654321

# Habilitar/deshabilitar bot (true/false)
BOT_ENABLED=false
